# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=primecore-os

# Make this the same as your github username/organisation
REPO_ORGANIZATION="nnnnndddht"

IMAGE_DESC="Prime Core OS - sistema gamer da Prime Core TI"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,bazzite,primecore"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/NNNNNDDDHT/primecore-os/main/system_files/usr/share/primecore/logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
